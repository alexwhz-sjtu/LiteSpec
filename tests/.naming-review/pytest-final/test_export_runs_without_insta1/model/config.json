{
  "architectures": [
    "DFlash2DraftModel"
  ],
  "attention_bias": false,
  "attention_dropout": 0.0,
  "auto_map": {
    "AutoModel": "dflash2.DFlash2DraftModel"
  },
  "block_size": 4,
  "dflash2_config": {
    "attention_mode": "gqa",
    "block_size": 4,
    "confidence_head_with_markov": true,
    "conv_group_size": 4,
