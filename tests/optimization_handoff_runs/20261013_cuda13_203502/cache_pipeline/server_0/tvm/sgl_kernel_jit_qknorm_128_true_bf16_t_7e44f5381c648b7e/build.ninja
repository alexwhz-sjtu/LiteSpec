ninja_required_version = 1.3
cxx = c++
cxxflags = -std=c++17 -fPIC -O2 -std=c++20 -O3 -I/root/.cache/uv/environments-v2/litespec-cp3.11-befba8bee4099476/lib/python3.11/site-packages/tvm_ffi/include -I/root/.cache/uv/environments-v2/litespec-cp3.11-befba8bee4099476/lib/python3.11/site-packages/tvm_ffi/include -I/root/.cache/uv/environments-v2/litespec-cp3.11-befba8bee4099476/lib/python3.11/site-packages/sglang/jit_kernel/include
nvcc = /usr/local/cuda-13.0/bin/nvcc
cuda_cflags = -Xcompiler -fPIC -std=c++17 -O2 -gencode=arch=compute_90,code=sm_90 -std=c++20 -O3 --expt-relaxed-constexpr -I/root/.cache/uv/environments-v2/litespec-cp3.11-befba8bee4099476/lib/python3.11/site-packages/tvm_ffi/include -I/root/.cache/uv/environments-v2/litespec-cp3.11-befba8bee4099476/lib/python3.11/site-packages/tvm_ffi/include -I/root/.cache/uv/environments-v2/litespec-cp3.11-befba8bee4099476/lib/python3.11/site-packages/sglang/jit_kernel/include
ldflags = -shared -L/root/.cache/uv/environments-v2/litespec-cp3.11-befba8bee4099476/lib/python3.11/site-packages/tvm_ffi/lib -ltvm_ffi -L/usr/local/cuda-13.0/lib64 -lcudart

rule compile
  depfile = $out.d
  deps = gcc
  command = $cxx -MMD -MF $out.d $cxxflags -c $in -o $out

rule compile_cuda
  depfile = $out.d
  deps = gcc
  command = $nvcc  --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out

rule merge_objects
  command = ld -r -o $out $in

rule copy_object
  command = cp -f $in $out

rule link
  command = $cxx $in $ldflags -o $out

build cuda_0.o: compile_cuda /diancpfs/user/wanghanzhen/LiteSpec/tests/optimization_handoff_runs/20261013_cuda13_203502/cache_pipeline/server_0/tvm/sgl_kernel_jit_qknorm_128_true_bf16_t_7e44f5381c648b7e/cuda.cu
build sgl_kernel_jit_qknorm_128_true_bf16_t.so: link cuda_0.o

default sgl_kernel_jit_qknorm_128_true_bf16_t.so
