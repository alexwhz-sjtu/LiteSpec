{
  "architectures": [
    "ComposableDraftModel"
  ],
  "attention_bias": false,
  "attention_dropout": 0.0,
  "auto_map": {
    "AutoConfig": "cs_composable_configuration.ComposableDraftConfig",
    "AutoModel": "cs_composable_modeling.ComposableDraftModel"
  },
  "block_size": 4,
  "composable_config": {
    "backbone": {
      "layers": [
        {
          "attention": {
            "access": "sliding_window",
            "backend": "sdpa",
            "representation": "mha",
            "window_size": 3
          }
        },
        {
          "attention": {
            "access": "sliding_window",
            "backend": "sdpa",
            "kv_lora_rank": 8,
            "qk_nope_head_dim": 4,
            "qk_rope_head_dim": 4,
            "representation": "mla",
            "v_head_dim": 8,
            "window_size": 3
          }
        }
      ],
      "type": "transformer"
    },
    "context": {
      "target_layer_ids": [
        1,
        5
      ],
      "type": "dflare"
    },
    "objective": {
      "loss_decay_gamma": 2.0,
      "type": "hard_ce"
    },
    "proposal": {
      "rank": 8,
      "top_k": 5,
      "type": "rnn"
    }
  },
  "dtype": "float32",
  "head_dim": 8,
  "hidden_act": "silu",
  "hidden_size": 32,
  "initializer_range": 0.02,
  "intermediate_size": 48,
  "layer_types": [
    "full_attention",
    "full_attention"
  ],
  "max_position_embeddings": 32768,
  "max_window_layers": 28,
  "model_type": "litespec_composable",
  "num_attention_heads": 4,
  "num_hidden_layers": 2,
  "num_key_value_heads": 2,
  "num_target_layers": 8,
  "rms_norm_eps": 1e-06,
  "rope_scaling": null,
  "rope_theta": 10000.0,
  "schema_version": "composable_v1",
  "sliding_window": null,
  "tie_word_embeddings": false,
  "transformers_version": "4.57.1",
  "use_cache": true,
  "use_sliding_window": false,
  "vocab_size": 23
}
