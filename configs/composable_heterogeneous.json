{
  "architectures": [
    "ComposableDraftModel"
  ],
  "block_size": 8,
  "composable_config": {
    "context": {
      "type": "dflare"
    },
    "backbone": {
      "type": "transformer",
      "layers": [
        {
          "attention": {
            "representation": "mha",
            "access": "sliding_window",
            "window_size": 512
          },
          "local_operator": {
            "type": "none"
          }
        },
        {
          "attention": {
            "representation": "mla",
            "access": "sliding_window",
            "window_size": 512,
            "kv_lora_rank": 512,
            "q_lora_rank": 512,
            "qk_nope_head_dim": 64,
            "qk_rope_head_dim": 64,
            "v_head_dim": 128
          },
          "local_operator": {
            "type": "none"
          }
        },
        {
          "attention": {
            "representation": "mha",
            "access": "dense"
          },
          "local_operator": {
            "type": "none"
          }
        },
        {
          "attention": {
            "representation": "mla",
            "access": "sliding_window",
            "window_size": 512,
            "kv_lora_rank": 512,
            "q_lora_rank": 512,
            "qk_nope_head_dim": 64,
            "qk_rope_head_dim": 64,
            "v_head_dim": 128
          },
          "local_operator": {
            "type": "none"
          }
        },
        {
          "attention": {
            "representation": "mha",
            "access": "dense"
          },
          "local_operator": {
            "type": "none"
          }
        }
      ]
    },
    "proposal": {
      "type": "rnn",
      "rank": 256
    },
    "objective": {
      "type": "nla",
      "loss_decay_gamma": 4.0
    }
  }
}
